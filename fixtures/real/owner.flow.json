{
  "schema": "kinetype.flow.v1",
  "name": "kvikk-owner",
  "app": { "name": "Kvikk (fixture app, Eier)", "baseUrl": "http://127.0.0.1:47213", "commit": "fixture" },
  "device": { "kind": "phone", "viewport": { "width": 360, "height": 672 }, "deviceScaleFactor": 3, "locale": "nb-NO", "timezone": "Europe/Oslo", "colorScheme": "light" },
  "fps": 60,
  "seed": 7,
  "steps": [
    { "id": "open", "action": "goto", "url": "/?role=owner", "hold": 3.2 },
    { "id": "browse", "action": "scroll", "by": 300, "duration": 0.9, "hold": 0.5 },
    { "id": "browse-up", "action": "scroll", "by": -300, "duration": 0.8, "hold": 1.0 },
    { "id": "new-item", "action": "click", "target": { "selector": "#new-item" }, "label": "Nytt tillegg", "hold": 0.9 },
    { "id": "desc", "action": "type", "target": { "selector": "#desc" }, "value": "Ekstra stikkontakt kjøkken", "cps": 16, "hold": 0.5 },
    { "id": "amount", "action": "type", "target": { "selector": "#amount" }, "value": "1 845", "cps": 16, "hold": 0.6 },
    { "id": "review", "action": "wait", "seconds": 2.0, "hold": 0.1 },
    { "id": "busy-from", "action": "mark" },
    { "id": "send", "action": "click", "target": { "selector": "#send" }, "label": "Send til kunden", "hold": 0 },
    { "id": "sent", "action": "observe", "target": { "selector": "#sent-title" }, "label": "Sendt til kunden", "hold": 0 },
    { "id": "busy-to", "action": "mark" },
    { "id": "linger", "action": "wait", "seconds": 3.3, "hold": 0 },
    { "id": "approved", "action": "observe", "target": { "selector": "#banner.on" }, "label": "Kari Nordmann godkjente 1 845 kr", "hold": 0 },
    { "id": "notify", "action": "mark" },
    { "id": "counter-wait", "action": "wait", "seconds": 0.45, "hold": 0 },
    { "id": "counter", "action": "mark" },
    { "id": "counted", "action": "wait", "seconds": 1.6, "hold": 0.4 },
    { "id": "scroll", "action": "scroll", "by": 620, "duration": 1.3, "hold": 1.0 },
    { "id": "scroll-end", "action": "scroll", "by": 380, "duration": 0.9, "hold": 2.4 }
  ]
}
